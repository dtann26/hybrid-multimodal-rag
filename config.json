{
  "app": {
    "title": "RAG Knowledge Base System",
    "host": "0.0.0.0",
    "port": 8000,
    "debug": false
  },
  "database": {
    "url": "sqlite:///./data/rag.db"
  },
  "milvus": {
    "host": "localhost",
    "port": 19530,
    "default_metric_type": "L2",
    "index_type": "GPU_IVF_FLAT"
  },
  "rag": {
    "chunk_size": 512,
    "chunk_overlap": 50,
    "top_k_retrieval": 50,
    "top_k_rerank": 5,
    "system_prompt": "You are a helpful assistant that answers questions based on the provided context. Always cite your sources when possible. If the context does not contain enough information, say so honestly.",
    "temperature": 0.7,
    "max_new_tokens": 2048,
    "reranker_threshold": 0.3
  },
  "auth": {
    "algorithm": "HS256",
    "access_token_expire_minutes": 1440
  },
  "models": {
    "default_llm": "Gemma-4-31B-IT-NVFP4",
    "llm_api_endpoint": "http://localhost:8001/v1",
    "default_embedding": "Qwen3-VL-Embedding-2B",
    "embedding_api_endpoint": "http://localhost:8002",
    "default_reranker": "Qwen3-VL-Reranker-2B",
    "reranker_api_endpoint": "http://localhost:8003",
    "embedding_dimension": 2048
  },
  "storage": {
    "upload_dir": "data/uploads",
    "models_dir": "data/models",
    "max_file_size_mb": 100
  },
  "superadmin": {
    "username": "admin",
    "email": "admin@localhost"
  }
}