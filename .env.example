# ── vLLM server configuration ────────────────────────────────────────
# Run `docker compose up -d` after editing this file.
#
# IMPORTANT: LLM_MODEL_DIR_NAME must match models.default_llm in config.json
# so the app knows which model name to send to the API.

# Directory name inside ./models/ for the LLM to serve.
# This is used by docker-compose.yml for the vllm-llm service command.
LLM_MODEL_DIR_NAME=Qwen2.5-VL-7B-Instruct-NVFP4

# Legacy — kept for reference
MODEL_SERVED_NAME=nvidia/Qwen2.5-VL-7B-Instruct-NVFP4

# Port the vLLM server listens on (must also match models.llm_api_endpoint in config.json)
VLLM_PORT=8001

# Model dtype: auto | float16 | bfloat16
DTYPE=auto

# Maximum sequence length the model will accept
MAX_MODEL_LEN=8192

# Number of GPUs to split the model across (tensor parallelism)
TENSOR_PARALLEL_SIZE=1

# MinIO host port overrides (change if 9000 is in use on the host)
# MINIO_CONSOLE_HOST_PORT maps the MinIO console port (container 9001)
# MINIO_HOST_PORT maps the MinIO S3 API port (container 9000)
MINIO_CONSOLE_HOST_PORT=9001
MINIO_HOST_PORT=9004

# Secure the JWT token generation (replace with a long, random string)
RAG_SECRET_KEY="a_really_long_and_random_secret_key_for_jwt_token_generation_1234567890"

# Secure the Superadmin access (replace with a strong password)
RAG_SUPERADMIN_PASSWORD="admin123"
